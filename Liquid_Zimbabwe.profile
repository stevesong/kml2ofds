[DEFAULT]
network_name = Liquid Telecom Zimbabwe
kml_file_name = Liquid_Zimbabwe.kml
output_name_prefix = LIQ-ZIM
network_id = 
physicalInfrastructureProvider_name = Liquid Intelligent Technologies
physicalInfrastructureProvider_id = LIT-1
networkProviders_name = Liquid Zimbabwe
networkProviders_id = Liquid-1
network_links = https://raw.githubusercontent.com/Open-Telecoms-Data/open-fibre-data-standard/0__3__0/schema/network-schema.json
# Separate placemarks to ignore with a semi-colon. Regex expressions accepted.
ignore_placemarks = 
# ignore_placemarks = 
# Threshold in meters for consolidating auto-generated nodes (default: 5000)
threshold_meters = 1000

[DIRECTORY]
input_directory = input/
output_directory = output/
